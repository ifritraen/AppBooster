<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for WorkManager foreground notifications on Android 9+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Android 14+ requires a foreground service type; WorkManager uses an internal FGS. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android 13+ notification permission (safe to request at runtime when needed) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:targetApi="33" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Package visibility (Android 11+/API 30+): apps targeting API >= 30 cannot see other
        installed packages unless declared here. Without this, PackageManager queries for the
        Shizuku app (getPackageInfo / getLaunchIntentForPackage) fail with NameNotFoundException,
        making the app report Shizuku as "not installed" even when it is running. A targeted
        <queries> entry is preferred over QUERY_ALL_PACKAGES, which Google Play restricts.
    -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="true"
        android:name=".AppBooster"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppBooster">

        <!-- WorkManager: ensure SystemForegroundService declares the FGS type used by ForegroundInfo. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Disable default WorkManager initialization; we use HiltWorkerFactory -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".presentation.activity.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppBooster">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".presentation.activity.QuickActionActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.tony.appbooster.ACTION_SCAN" />
                <action android:name="com.tony.appbooster.ACTION_OPTIMIZE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".presentation.worker.OptimizationWorkerStopReceiver"
            android:exported="false" />

        <receiver
            android:name=".presentation.receiver.DeviceUnlockReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".presentation.widget.OptiDroidWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.tony.appbooster.widget.ACTION_SCAN" />
                <action android:name="com.tony.appbooster.widget.ACTION_OPTIMIZE" />
                <action android:name="com.tony.appbooster.widget.ACTION_STOP" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/optidroid_widget_info" />
        </receiver>

        <service
            android:name=".presentation.tile.OptiDroidTileService"
            android:exported="true"
            android:icon="@drawable/ic_optimize"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Shizuku Provider for privileged operations -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>